<?xml version="1.0" encoding="utf-8"?>
<!--
  TcgEngine 节点定义字典（Node Definition Dictionary）
  ==================================================
  对齐《醉梦传说》NodeDoc.xml 的 ArrayOfActionComment 结构生成。
  用途：作为本项目 DIY 卡牌节点系统的基础层——把现有
  Effect(效果) / Condition(条件) / Filter(筛选) 全部暴露成可连线节点。

  编号规则：
    Effect    -> 100001~100099  （动作节点：真正执行一件事）
    Condition -> 200001~200099  （判定节点：返回 true/false）
    Filter    -> 300001~300099  （集合节点：筛选/排序/随机取）

  类型约定（type）：
    Integer / Boolean / StatType / Pile / CardType / CardDefine
    AbilityDefine / StatusDefine / TraitDefine / TeamDefine
    CompareOp / BoolOp / NumericOp / RepeatType / AttackerType / TargetCategory / Player
-->
<ArrayOfActionComment xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- ============================ 效果 Effect（动作节点） ============================ -->

  <!-- 造成伤害（伤害值可接 ValueSource，value=0 时动态取 selected_value 兼容） -->
  <ActionComment>
    <defineId>100001</defineId>
    <editorName>造成伤害</editorName>
    <category>效果</category>
    <inputs>
      <ActionParameterComment>
        <type>AbilityDefine</type><name>ability</name><displayName>所属能力</displayName><summary><![CDATA[提供基础 value 作为伤害值]]></summary>
      </ActionParameterComment>
      <ActionParameterComment>
        <type>TraitDefine</type><name>bonus_damage</name><displayName>特质加成</displayName><summary><![CDATA[选一个特质，施法者若带该特质则伤害+X]]></summary>
      </ActionParameterComment>
    </inputs>
    <outputs />
    <summary><![CDATA[对目标造成伤害。伤害值 = 所属能力.value（或读取动态值 selected_value）。可选特质加成。]]></summary>
  </ActionComment>

